# Copy to `.env` and adjust. Validated at boot by src/core/env.validation.ts;
# the app refuses to start on an invalid value. Required variables have no default.

NODE_ENV=development
PORT=4000

# --- Database (required) ---
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/task-forge
# e2e tests use a disposable database named `<name>_test` on the same server (created automatically).
# Override the server with DATABASE_URL_TEST if you do not want tests to touch the server above.
# Pool tuning (defaults shown)
# DB_POOL_MAX=10
# DB_CONNECTION_TIMEOUT_MS=5000
# DB_IDLE_TIMEOUT_MS=30000
# Verify the server certificate (managed Postgres)
# DB_SSL=false

# --- Web ---
# Exact browser origin(s), comma-separated, no wildcard. REQUIRED when NODE_ENV=production.
FRONTEND_ORIGIN=http://localhost:3000
# Reverse-proxy hops to trust for the client IP (0 = none). Set to 1 behind one load balancer.
# TRUST_PROXY_HOPS=0

# --- Rate limiting (per IP) ---
# THROTTLE_TTL_MS=60000
# THROTTLE_LIMIT=600
# THROTTLE_ENABLED=true

# --- Logging ---
# fatal | error | warn | info | debug | trace | silent
# LOG_LEVEL=info
# json | pretty  (default: pretty in development, json in production)
# LOG_FORMAT=pretty

# --- OpenAPI UI at /api/docs (default: on outside production) ---
# SWAGGER_ENABLED=true

# --- Authentication ---
# HMAC key for access tokens, >= 32 chars. Rotating it signs everyone out.
#   openssl rand -base64 48
JWT_ACCESS_SECRET=
# JWT_ACCESS_TTL_MINUTES=15
# REFRESH_TTL_DAYS=7
# PASSWORD_RESET_TTL_MINUTES=60
# Cookie flags for the refresh token. Secure defaults on in production. Use SAMESITE=none ONLY if the
# frontend and API sit on different registrable domains (then Secure is mandatory).
# COOKIE_SECURE=true
# COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=
