# Copy to `.env` and adjust. Validated at boot by src/core/env.validation.ts;
# the app refuses to start on an invalid value. Required variables have no default.

NODE_ENV=development
PORT=4040

# --- Database (required) ---
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/task-forge
# Pool tuning (defaults shown)
# DB_POOL_MAX=10   (defaults to 1 on Vercel; use the provider's pooled / pgbouncer URL there)
# DB_CONNECTION_TIMEOUT_MS=5000
# DB_IDLE_TIMEOUT_MS=30000   (defaults to 5000 on Vercel)
# Managed Postgres has a small connection cap (Aiven free: ~20). On Vercel use the provider's
# connection-pool (PgBouncer) URL, not the direct one, or instances exhaust the slots.
# Verify the server certificate (managed Postgres)
# DB_SSL=false

# --- Web ---
# Exact browser origin(s), comma-separated, no wildcard. REQUIRED when NODE_ENV=production.
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:4000
# Reverse-proxy hops to trust for the client IP (0 = none). Set to 1 on Vercel / behind one load balancer.
# TRUST_PROXY_HOPS=0

# --- Rate limiting (per IP) ---
# THROTTLE_TTL_MS=60000
# THROTTLE_LIMIT=600
# THROTTLE_ENABLED=true

# --- Logging ---
# fatal | error | warn | info | debug | trace | silent
# LOG_LEVEL=info
# json | pretty  (default: pretty in development, json in production)
# LOG_FORMAT=pretty

# --- OpenAPI UI at /api/docs (default: on outside production) ---
# SWAGGER_ENABLED=true

# --- Authentication ---
# HMAC key for access tokens, >= 32 chars. Rotating it signs everyone out.
#   openssl rand -base64 48
JWT_ACCESS_SECRET=
# JWT_ACCESS_TTL_MINUTES=15
# REFRESH_TTL_DAYS=7
# PASSWORD_RESET_TTL_MINUTES=60
# Cookie flags for the refresh token. Secure defaults on in production. Use SAMESITE=none ONLY if the
# frontend and API sit on different registrable domains (then Secure is mandatory).
# COOKIE_SECURE=true
# COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=
# Cross-site frontend (e.g. localhost -> *.vercel.app): COOKIE_SAMESITE=none + COOKIE_SECURE=true.
# Same-site subdomains (app.example.com + api.example.com): COOKIE_DOMAIN=.example.com
